  "query": "SELECT id as \"id!: i64\", source_id, tvg_id, name, country, category, raw_group, logo_url, stream_url, is_favorite, is_in_watchlist, last_played_at, added_at, dedup_group, channel_group, region\n                 FROM channels\n                 WHERE source_id = ?\n                   AND (? IS NULL OR country = ?)\n                   AND (? IS NULL OR category = ?)\n                   AND (? IS NULL OR region = ?)\n                   AND (? IS NULL OR name LIKE ? OR category LIKE ? OR raw_group LIKE ?)\n                   AND (? = 0 OR is_favorite = 1)\n                   AND (? = 0 OR is_in_watchlist = 1)\n                 ORDER BY id ASC LIMIT ? OFFSET ?",
