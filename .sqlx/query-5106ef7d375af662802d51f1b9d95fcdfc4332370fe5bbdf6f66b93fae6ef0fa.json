  "query": "SELECT id as \"id!: i64\", source_id, name, clean_title, year, logo_url, stream_url, category, is_favorite, is_in_watchlist, added_at, dedup_group\n                 FROM vod_items\n                 WHERE source_id = ?\n                   AND (? IS NULL OR category = ?)\n                   AND (? IS NULL OR name LIKE ? OR clean_title LIKE ? OR category LIKE ?)\n                   AND (? = 0 OR is_favorite = 1)\n                   AND (? = 0 OR is_in_watchlist = 1)\n                 ORDER BY added_at DESC, id DESC LIMIT ? OFFSET ?",
