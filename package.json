{
  "name": "nova",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm -C apps/desktop exec tauri dev",
    "build": "pnpm -C apps/desktop exec tauri build",
