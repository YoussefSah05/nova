{
  "name": "nova",
  "version": "0.2.0-alpha.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "stack": "node scripts/stack.mjs stack",
    "doctor": "node scripts/stack.mjs doctor",
    "verify-environment": "node scripts/stack.mjs verify-environment",
    "test:environment": "node --test scripts/stack.test.mjs",
    "test:catalog-eval": "node --test tools/catalog-eval/evaluate.test.mjs",
    "eval:catalog": "node tools/catalog-eval/evaluate.mjs",
    "eval:catalog:reference": "node tools/catalog-eval/evaluate.mjs --manifest tools/catalog-eval/qwen35-4b.manifest.json --prompt-version v2",
    "dev": "pnpm -C apps/desktop exec tauri dev",
    "build": "pnpm -C apps/desktop exec tauri build",
    "test": "pnpm -C apps/desktop run test",
    "lint": "pnpm -C apps/desktop run lint",
    "format": "pnpm -C apps/desktop run format",
    "typecheck": "pnpm -C apps/desktop run typecheck",
    "clean": "pnpm -C apps/desktop run clean",
    "fixture:scale": "node tools/catalog-scale/provider.mjs",
    "test:scale": "node --test tools/catalog-scale/provider.test.mjs"
  }
}
